# Change OLLAMA_URL to your reachable Windows PC's Ollama API (not localhost).
# Verify Windows Firewall allows the VM to connect and Ollama is listening on the LAN interface.
OLLAMA_URL=http://192.168.2.157:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_MODEL=qwen3.5:9b

# SAFE by default: 127.0.0.1 means host-only; for controlled LAN use, set VM LAN IP.
BIND_IP=127.0.0.1
WEBUI_PORT=3000
DVWA_PORT=4280
ZAP_GUI_PORT=8088

# Generated by start.sh if empty. NEVER commit .env.
WEBUI_SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Fill these AFTER creating the OWASP collection and admin API key in Open WebUI.
KNOWLEDGE_ID=
OPENWEBUI_API_KEY=

# Optional images; pin versions or digests for a reproducible deployment.
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
CHROMA_IMAGE=chromadb/chroma:1.5.3
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
DVWA_IMAGE=ghcr.io/digininja/dvwa:latest
MARIADB_IMAGE=mariadb:10.11
